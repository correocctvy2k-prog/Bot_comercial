# Seguridad Electrónica / CCTV Automation
# Copiar como .env en el servidor y completar fuera del control de versiones.

# Correo IMAP de solo lectura
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
VISITORS_IMAP_FOLDER=Reporte Visitantes

# Procesamiento Dahua
VENTANA_INICIO=05:30
VENTANA_FIN=23:00
VENTANA_RAFAGA_MIN=8
UMBRAL_RUIDO=10
PROCESAR_TODO_PRIMERA_EJECUCION=false
EXCEL_OUTPUT_PATH=./output/CCTV_Eventos.xlsx

# API SIIS/SIISS
SIISS_URL=
SIISS_USER=
SIISS_PASS=
SIISS_TIMEOUT_MS=8000
SIIS_PEAK_WINDOWS=APERTURA@05:30-09:45,CIERRE_MEDIODIA@12:30-14:15,REAPERTURA@14:30-16:30,CIERRES_ESPECIALES@17:30-19:00,CIERRE_NOCTURNO@20:30-23:00

# API local de Seguridad Electrónica
# En producción se recomienda 127.0.0.1 detrás de un proxy HTTPS autenticado.
CCTV_API_HOST=127.0.0.1
CCTV_API_PORT=3003
CCTV_DB=./data/cctv-staging.db

# Persistencia. Los defaults conservan el layout local actual; en Docker se
# montan fuera del código bajo /var/lib/skylab-security.
CCTV_DATA_ROOT=./data
IMAP_STATE_PATH=./state.json
EVENT_SNAPSHOT_DIR=./data/event-snapshots
SUPPORT_IMAGE_DIR=./data/support-images
CCTV_LOG_DIR=./logs
CCTV_REPORT_DIR=./reports
CCTV_OUTPUT_DIR=./output
SIIS_SNAPSHOT_PATH=./data/siis-snapshot-latest.json

# Integración Trello
MAINTENANCE_SYNC_INTERVAL_MINUTES=1
OPERATIONAL_CYCLE_INTERVAL_MS=60000
VISITOR_IMPORT_HOUR=20
VISITOR_WORKER_POLL_MS=300000
TRELLO_CACHE_DB=
TRELLO_ENV_FILE=
TRELLO_BACKEND_ROOT=
EXCEL_FILE_PATH=
TRELLO_SUPPORT_BOARD_ID=
TRELLO_SUPPORT_2025_BOARD_ID=

# TRELLO_API_KEY y TRELLO_TOKEN pueden residir en TRELLO_ENV_FILE.
# No duplicarlos aquí salvo que el servicio se ejecute con un almacén de secretos.
TRELLO_API_KEY=
TRELLO_TOKEN=
