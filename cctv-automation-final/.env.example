# Seguridad Electrónica / CCTV Automation
# Copiar como .env en el servidor y completar fuera del control de versiones.

# Correo IMAP de solo lectura
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
VISITORS_IMAP_FOLDER=Reporte Visitantes

# Procesamiento Dahua
VENTANA_INICIO=05:30
VENTANA_FIN=23:00
VENTANA_RAFAGA_MIN=8
UMBRAL_RUIDO=10
PROCESAR_TODO_PRIMERA_EJECUCION=false
EXCEL_OUTPUT_PATH=./output/CCTV_Eventos.xlsx

# Eventos diarios — ventanas operativas (jornada partida, hora local Bogotá). spec 0010.
# El ping SIIS es el vector primario; el CCTV es apoyo / prueba visual.
CCTV_WIN_OPEN_AM=05:00-09:30
CCTV_WIN_OPEN_PM=15:00-17:00
CCTV_WIN_CLOSE_PM=18:00-22:00
# Cierre a mediodía: DESACTIVADO por defecto (casi ninguna tienda cierra a
# mediodía y su ventana con gracia se solapaba con la mañana). Actívalo solo si
# un punto real lo necesita, p. ej. CCTV_WIN_CLOSE_MIDDAY=13:00-14:00
CCTV_WIN_CLOSE_MIDDAY=
# Gracia (min) para apertura tardía / cierre temprano al asignar la fase.
CCTV_WIN_GRACE_MIN=150
# Desfase máximo (min) ping↔evento CCTV sin marcar inconsistencia de configuración.
CCTV_PING_EVENT_TOLERANCE_MIN=20

# Sync Operación de Puntos <-> CCTV (spec 0012). scripts/sync-crm-points.js.
# Misma llave que ChatBotSoporte (mismo proyecto Supabase) — decisión del usuario 2026-09-11.
# Bypassa RLS: nunca se loguea, no se versiona (.env está en .gitignore).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cadencia del paso en el ciclo operativo (minutos). Default 1440 = una vez al día.
CRM_POINTS_SYNC_INTERVAL_MINUTES=1440

# API SIIS/SIISS
SIISS_URL=
SIISS_USER=
SIISS_PASS=
SIISS_TIMEOUT_MS=8000
SIIS_PEAK_WINDOWS=APERTURA@05:30-09:45,CIERRE_MEDIODIA@12:30-14:15,REAPERTURA@14:30-16:30,CIERRES_ESPECIALES@17:30-19:00,CIERRE_NOCTURNO@20:30-23:00

# API local de Seguridad Electrónica
# En producción se recomienda 127.0.0.1 detrás de un proxy HTTPS autenticado.
CCTV_API_HOST=127.0.0.1
CCTV_API_PORT=3003
CCTV_DB=./data/cctv-staging.db

# Persistencia. Los defaults conservan el layout local actual; en Docker se
# montan fuera del código bajo /var/lib/skylab-security.
CCTV_DATA_ROOT=./data
IMAP_STATE_PATH=./state.json
EVENT_SNAPSHOT_DIR=./data/event-snapshots
SUPPORT_IMAGE_DIR=./data/support-images
CCTV_LOG_DIR=./logs
CCTV_REPORT_DIR=./reports
CCTV_OUTPUT_DIR=./output
SIIS_SNAPSHOT_PATH=./data/siis-snapshot-latest.json

# Integración Trello
MAINTENANCE_SYNC_INTERVAL_MINUTES=1
OPERATIONAL_CYCLE_INTERVAL_MS=60000
VISITOR_IMPORT_HOUR=20
VISITOR_WORKER_POLL_MS=300000
TRELLO_ENV_FILE=
EXCEL_FILE_PATH=
TRELLO_SUPPORT_BOARD_ID=
TRELLO_SUPPORT_2025_BOARD_ID=
# spec 0008: mantenimiento se lee directo de la API de Trello (ya no de la caché
# skylab-tareas.db). Board "Mantenimientos" que contiene la lista MANTENIMIENTO CCTV 2026.
TRELLO_MAINTENANCE_BOARD_ID=62a0bd9b2203177716f8afdc
# Opcional: nombre de la lista (por defecto "MANTENIMIENTO CCTV 2026").
TRELLO_MAINTENANCE_LIST_NAME=

# TRELLO_API_KEY y TRELLO_TOKEN pueden residir en TRELLO_ENV_FILE.
# No duplicarlos aquí salvo que el servicio se ejecute con un almacén de secretos.
TRELLO_API_KEY=
TRELLO_TOKEN=
