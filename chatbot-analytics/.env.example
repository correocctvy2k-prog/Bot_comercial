# ============================================================
#  Plantilla de configuración.  Copia a  .env  y ajusta.
#  El .env NO debe versionarse (contiene credenciales).
# ============================================================

# Puerto del servidor web
PORT=3000

# ------------------------------------------------------------
#  FUENTE DE LOS LOGS
#  local -> lee archivos del disco de esta máquina
#  ssh   -> lee los logs directo del servidor del chatbot
# ------------------------------------------------------------
LOG_SOURCE=local

# ===== OPCIÓN A · LOG_SOURCE=local =====
# Oskitar (obligatorio en modo local). Sin definir usa conversations.sample.log
# LOG_PATH=/var/log/oskitar/conversations.log
# Betty (opcional; aparece solo si defines los dos)
# BETTY_MESSAGES_PATH=/var/log/betty/messages.log
# BETTY_STATE_PATH=/var/log/betty/state-manager.log

# ===== OPCIÓN B · LOG_SOURCE=ssh =====
# Requiere:  npm install ssh2
# LOG_SSH_HOST=10.0.0.20
# LOG_SSH_PORT=22
# LOG_SSH_USER=usuario
# Autenticación: clave privada (recomendado) …
# LOG_SSH_KEY=/home/usuario/.ssh/id_ed25519
# LOG_SSH_PASSPHRASE=
# … o contraseña
# LOG_SSH_PASSWORD=
# Rutas ABSOLUTAS de los logs en el servidor remoto:
# LOG_SSH_REMOTE_PATH=/home/app/ChatBotSoporte/logs/conversations.log
# LOG_SSH_BETTY_MESSAGES=/home/app/ChatBotBetty/logs/messages.log
# LOG_SSH_BETTY_STATE=/home/app/ChatBotBetty/logs/state-manager.log

# ------------------------------------------------------------
#  PRIVACIDAD
# ------------------------------------------------------------
# Teléfonos y cédulas enmascarados (57••••••4631 / •••••••985).
# Poner 0 para mostrarlos completos.
# MASK_PHONES=0

# ------------------------------------------------------------
#  HISTÓRICO ACUMULATIVO  (carpeta ./data, solo crece)
# ------------------------------------------------------------
# HISTORY_DIR=./data
# HISTORY_DAYS=0        # 0 = guardar todo · ej. 180 = últimos 180 días

# ------------------------------------------------------------
#  AJUSTES DE ANÁLISIS
# ------------------------------------------------------------
# SESSION_GAP_MIN=30      # minutos de inactividad que cierran una sesión (Oskitar)
# TZ_OFFSET_HOURS=-5      # huso para los cortes por día/hora (Colombia = -5)
# BETTY_STATE_TTL_SEC=720 # ventana que se resta al 'timeout' de Betty (~12 min)
# WATCH_DEBOUNCE_MS=400
# WATCH_POLL_MS=3000
# BETTY_DISABLED=1        # oculta Betty aunque esté configurada
